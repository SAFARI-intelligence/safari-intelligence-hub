# Copy this file to .env or .env.local and provide your own values.
# Do not commit your .env file to source control.

# Public Supabase keys — safe to expose to client builds.
# Access via: import.meta.env.VITE_SUPABASE_URL and import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets below — never expose to client builds.
# Uncomment and provide values only in secure (non-committed) .env/.env.local for dev/production.

# Supabase admin operations (Edge Functions, server-side RLS bypass).
# SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API for server-side reasoning, agent operations, and integrations.
# ANTHROPIC_API_KEY=

# Lovable AI gateway (pending TS-02 rewrite decision; keep for now).
# LOVABLE_API_KEY=
